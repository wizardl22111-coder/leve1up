<svg width="1200" height="600" viewBox="0 0 1200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="subsBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:0.8" />
      <stop offset="50%" style="stop-color:#14B8A6;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#1a1a1a;stop-opacity:0.9" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="600" fill="url(#subsBg)"/>
  
  <!-- Grid Pattern -->
  <defs>
    <pattern id="subsGrid" width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M 50 0 L 0 0 0 50" fill="none" stroke="rgba(16, 185, 129, 0.1)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1200" height="600" fill="url(#subsGrid)" />
  
  <!-- Subscription Icons -->
  <g transform="translate(150, 150)">
    <!-- Netflix -->
    <rect x="0" y="0" width="60" height="40" rx="6" fill="rgba(220, 38, 38, 0.8)"/>
    <text x="30" y="25" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="12" font-weight="bold">N</text>
    
    <!-- Spotify -->
    <circle cx="100" cy="20" r="20" fill="rgba(34, 197, 94, 0.8)"/>
    <path d="M 85 15 Q 100 10 115 15 M 85 20 Q 100 15 115 20 M 85 25 Q 100 20 115 25" stroke="white" stroke-width="2" fill="none"/>
    
    <!-- YouTube -->
    <rect x="150" y="0" width="60" height="40" rx="6" fill="rgba(239, 68, 68, 0.8)"/>
    <polygon points="170,12 170,28 185,20" fill="white"/>
    
    <!-- Discord -->
    <rect x="0" y="60" width="60" height="40" rx="6" fill="rgba(99, 102, 241, 0.8)"/>
    <circle cx="20" cy="75" r="3" fill="white"/>
    <circle cx="40" cy="75" r="3" fill="white"/>
    <path d="M 15 85 Q 30 90 45 85" stroke="white" stroke-width="2" fill="none"/>
  </g>
  
  <!-- Subscription Cards -->
  <g transform="translate(700, 100)">
    <!-- Card 1 -->
    <rect x="0" y="0" width="120" height="80" rx="8" fill="rgba(16, 185, 129, 0.2)" stroke="rgba(16, 185, 129, 0.6)" stroke-width="2"/>
    <text x="60" y="25" text-anchor="middle" fill="rgba(255, 255, 255, 0.9)" font-family="Arial, sans-serif" font-size="12" font-weight="bold">Premium</text>
    <text x="60" y="45" text-anchor="middle" fill="rgba(16, 185, 129, 0.8)" font-family="Arial, sans-serif" font-size="16" font-weight="bold">99 ر.س</text>
    <text x="60" y="65" text-anchor="middle" fill="rgba(255, 255, 255, 0.6)" font-family="Arial, sans-serif" font-size="10">شهرياً</text>
    
    <!-- Card 2 -->
    <rect x="140" y="0" width="120" height="80" rx="8" fill="rgba(20, 184, 166, 0.2)" stroke="rgba(20, 184, 166, 0.6)" stroke-width="2"/>
    <text x="200" y="25" text-anchor="middle" fill="rgba(255, 255, 255, 0.9)" font-family="Arial, sans-serif" font-size="12" font-weight="bold">Pro</text>
    <text x="200" y="45" text-anchor="middle" fill="rgba(20, 184, 166, 0.8)" font-family="Arial, sans-serif" font-size="16" font-weight="bold">149 ر.س</text>
    <text x="200" y="65" text-anchor="middle" fill="rgba(255, 255, 255, 0.6)" font-family="Arial, sans-serif" font-size="10">شهرياً</text>
  </g>
  
  <!-- Crown Icon -->
  <g transform="translate(550, 200)">
    <path d="M 0 20 L 10 0 L 20 15 L 30 0 L 40 20 L 35 30 L 5 30 Z" fill="rgba(251, 191, 36, 0.8)" stroke="rgba(251, 191, 36, 1)" stroke-width="1"/>
    <circle cx="10" cy="5" r="2" fill="rgba(251, 191, 36, 1)"/>
    <circle cx="20" cy="2" r="3" fill="rgba(251, 191, 36, 1)"/>
    <circle cx="30" cy="5" r="2" fill="rgba(251, 191, 36, 1)"/>
  </g>
  
  <!-- Text -->
  <text x="600" y="350" text-anchor="middle" fill="rgba(255, 255, 255, 0.9)" font-family="Arial, sans-serif" font-size="48" font-weight="bold">الاشتراكات</text>
  <text x="600" y="400" text-anchor="middle" fill="rgba(255, 255, 255, 0.7)" font-family="Arial, sans-serif" font-size="24">المميزة</text>
  
  <!-- Decorative Elements -->
  <circle cx="150" cy="450" r="50" fill="rgba(16, 185, 129, 0.1)" />
  <circle cx="1050" cy="150" r="70" fill="rgba(20, 184, 166, 0.1)" />
  
  <!-- Floating Elements -->
  <g transform="translate(300, 400)">
    <rect x="0" y="0" width="30" height="20" rx="4" fill="rgba(16, 185, 129, 0.3)" />
    <text x="15" y="13" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="8">50%</text>
  </g>
  
  <g transform="translate(900, 350)">
    <rect x="0" y="0" width="40" height="25" rx="4" fill="rgba(239, 68, 68, 0.6)" />
    <text x="20" y="16" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="10">وفر</text>
  </g>
</svg>
